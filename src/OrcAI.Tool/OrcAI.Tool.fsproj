<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>orcai</AssemblyName>
    <RootNamespace>OrcAI.Tool</RootNamespace>
    <PackageId>OrcAI.Tool</PackageId>
    <PackAsTool>true</PackAsTool>
    <Nullable>enable</Nullable>
    <Optimize>true</Optimize>
    <!-- Binary identity -->
    <Version>0.10.4</Version>
    <Authors>Devon Burriss</Authors>
    <Description>A CLI tool for managing GitHub Projects and Copilot-assigned issues in bulk. Define your project in a YAML file and let orcai create issues, assign them to Copilot, and clean up when done.</Description>
    <Title>orcai</Title>
    <ToolCommandName>orcai</ToolCommandName>
    <Copyright>Copyright © 2025 Devon Burriss</Copyright>
    <!-- Links -->
    <PackageProjectUrl>https://github.com/dburriss/orca</PackageProjectUrl>
    <RepositoryUrl>https://github.com/dburriss/orca</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- Licensing -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- Discoverability -->
    <PackageTags>github copilot cli project-management automation</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>`FetchReposState`'s two batches (`isArchived` and `search`, split in 0.10.3) now fetch their chunks concurrently instead of one at a time. Splitting the `search` batch down to 15 repos increased the number of sequential GraphQL round trips (e.g. 13 for 152 repos, up from 4); since this prefetch always runs single-threaded ahead of the per-repo fan-out regardless of `--parallel`/`--no-parallel`, running it sequentially made it the dominant cost of the whole run. Chunks are now dispatched with `Async.Parallel`, bounded/paced by the existing shared `ApiBucket` (which already rate-limits concurrent callers and pauses all of them together on a detected rate limit).</PackageReleaseNotes>
    <!-- SourceLink / reproducible builds -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\NUGET.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Args.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\OrcAI.Core\OrcAI.Core.fsproj" />
    <ProjectReference Include="..\OrcAI.GitHub\OrcAI.GitHub.fsproj" />
    <ProjectReference Include="..\OrcAI.Auth\OrcAI.Auth.fsproj" />
    <ProjectReference Include="..\OrcAI.Local\OrcAI.Local.fsproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Argu" Version="6.2.4" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <PackageReference Include="SimpleExec" Version="12.0.0" />
    <PackageReference Include="Spectre.Console" Version="0.49.1" />
    <PackageReference Include="Testably.Abstractions" Version="10.1.0" />
  </ItemGroup>
</Project>